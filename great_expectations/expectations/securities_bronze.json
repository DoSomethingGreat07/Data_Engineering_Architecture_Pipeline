{
  "suite_name": "securities_bronze",
  "expectations": [
    {
      "expectation_type": "ExpectTableColumnsToMatchSet",
      "kwargs": {
        "column_set": [
          "security_id",
          "ticker",
          "security_name",
          "security_type",
          "exchange_code",
          "currency_code"
        ]
      }
    },
    {
      "expectation_type": "ExpectColumnValuesToNotBeNull",
      "kwargs": {
        "column": "security_id",
        "mostly": 1.0
      }
    },
    {
      "expectation_type": "ExpectColumnValuesToBeUnique",
      "kwargs": {
        "column": "security_id",
        "mostly": 1.0
      }
    },
    {
      "expectation_type": "ExpectColumnValuesToMatchRegex",
      "kwargs": {
        "column": "ticker",
        "regex": "^[A-Z0-9._-]+$",
        "mostly": 1.0
      }
    },
    {
      "expectation_type": "ExpectColumnValuesToBeInSet",
      "kwargs": {
        "column": "currency_code",
        "value_set": ["USD", "EUR", "GBP", "JPY", "CAD", "AUD"]
      }
    }
  ]
}
